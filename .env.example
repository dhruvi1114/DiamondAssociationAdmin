# =============================================================================
# Admin app environment template (Vite)
# =============================================================================
# Vite inlines every VITE_* variable into the bundle at build time. Treat all of
# them as PUBLIC — anyone who opens dev tools can read them (security.md §4).
# Never add a JWT secret, SMTP password, database URL or gateway key here.
#
# Copy to `.env.local` for development. Only this template is tracked.
# =============================================================================

# Backend API origin. Port 4000 per versions.md (3000 customer, 3001 admin).
VITE_API_BASE_URL=http://localhost:4000

# Payload encryption (ADR-004). Must match the backend's CHIPER / TERIFF / PLAN
# for the SAME environment, byte for byte, or every request fails with 400.
VITE_CHIPER=aes-256-cbc
VITE_TERIFF=00000000000000000000000000000000
VITE_PLAN=0000000000000000
